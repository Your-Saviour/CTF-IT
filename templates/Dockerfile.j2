FROM ctf-base:latest
{% if operations %}

{% for op in operations %}
{% if op.type == "copy" -%}
COPY files/{{ op.staged }} {{ op.dest }}
{% if op.mode -%}
RUN chmod {{ op.mode }} {{ op.dest }}
{% endif -%}
{% elif op.type == "run" -%}
COPY scripts/{{ op.script }} /tmp/scripts/{{ op.script }}
RUN chmod +x /tmp/scripts/{{ op.script }} && /tmp/scripts/{{ op.script }} && rm /tmp/scripts/{{ op.script }}
{% endif -%}
{% endfor %}
{% endif %}
ARG FLAG
RUN echo "$FLAG" > /root/flag.txt && chmod 400 /root/flag.txt

COPY state.json /opt/ctf/state.json
COPY audit.py /opt/ctf/audit.py

# Capture build-time system state (e.g. original password hashes)
COPY build_snapshot.py /tmp/build_snapshot.py
RUN python3 /tmp/build_snapshot.py && rm /tmp/build_snapshot.py \
  && chmod 400 /opt/ctf/state.json
