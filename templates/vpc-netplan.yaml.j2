# VPC interface configuration — managed by CTF platform
network:
  version: 2
  ethernets:
    vpc:
      match:
        macaddress: {{ vpc_mac }}
      set-name: ctf-lan
      mtu: {{ vpc_mtu | default(1500) }}
      addresses:
        - {{ vpc_ip }}/{{ vpc_subnet_mask }}
      routes:
        - to: 10.0.0.0/8
          via: {{ vpc_gateway }}
