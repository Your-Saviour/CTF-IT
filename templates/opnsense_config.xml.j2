<?xml version="1.0"?>
<opnsense>
  <theme>opnsense</theme>
  <sysctl>
    <item>
      <descr>Increase UFS read-ahead speeds</descr>
      <tunable>vfs.read_max</tunable>
      <value>default</value>
    </item>
    <item>
      <descr>Enable TCP keepalives</descr>
      <tunable>net.inet.tcp.always_keepalive</tunable>
      <value>1</value>
    </item>
  </sysctl>
  <system>
    <optimization>normal</optimization>
    <hostname>{{ opnsense_hostname }}</hostname>
    <domain>localdomain</domain>
    <dnsserver>1.1.1.1</dnsserver>
    <dnsserver>8.8.8.8</dnsserver>
    <group>
      <name>admins</name>
      <description>System Administrators</description>
      <scope>system</scope>
      <gid>1999</gid>
      <member>0</member>
      <priv>page-all</priv>
    </group>
    <user>
      <name>root</name>
      <descr>System Administrator</descr>
      <scope>system</scope>
      <groupname>admins</groupname>
      <password>{{ opnsense_admin_password_hash }}</password>
      <uid>0</uid>
      <authorizedkeys>{{ opnsense_ssh_pubkey | b64encode }}</authorizedkeys>
    </user>
    <nextuid>2000</nextuid>
    <nextgid>2000</nextgid>
    <timezone>UTC</timezone>
    <language>en_US</language>
    <disablecheck>1</disablecheck>
    <ssh>
      <enabled>1</enabled>
      <port>22</port>
      <permitrootlogin>1</permitrootlogin>
      <interfaces>{% if temporary_management | default(true) %}wan,lan{% else %}lan{% endif %}</interfaces>
      <group>admins</group>
    </ssh>
    <webgui>
      <protocol>https</protocol>
      <port>443</port>
      <nohttpreferercheck>1</nohttpreferercheck>
      <noantilockout>1</noantilockout>
      <interfaces>lan</interfaces>
    </webgui>
  </system>
  <interfaces>
    <wan>
      <if>{{ opnsense_wan_interface }}</if>
      <descr>WAN</descr>
      <enable>1</enable>
      <spoofmac/>
      <ipaddr>dhcp</ipaddr>
      <dhcphostname/>
      <alias-address/>
      <alias-subnet>32</alias-subnet>
      <gateway/>
    </wan>
    <lan>
      <if>{{ opnsense_lan_interface }}</if>
      <descr>LAN</descr>
      <enable>1</enable>
      <spoofmac/>
      <ipaddr>{{ opnsense_lan_ip }}</ipaddr>
      <subnet>{{ opnsense_lan_subnet }}</subnet>
    </lan>
  </interfaces>
{% if opnsense_vpc_gateway %}
  <gateways>
    <gateway_item>
      <interface>lan</interface><gateway>{{ opnsense_vpc_gateway }}</gateway>
      <name>VPC_LAN_GATEWAY</name><priority>255</priority><weight>1</weight>
      <ipprotocol>inet</ipprotocol><monitor_disable>1</monitor_disable>
      <descr>AWS VPC router</descr>
    </gateway_item>
  </gateways>
  <staticroutes>
    <route><network>{{ opnsense_routed_site_network }}</network><gateway>VPC_LAN_GATEWAY</gateway>
      <descr>GameNet zone subnets</descr></route>
  </staticroutes>
{% else %}
  <gateways/>
  <staticroutes/>
{% endif %}
  <filter/>
  <OPNsense>
    <Firewall>
      <Filter>
        <general><snat_mode>automatic</snat_mode></general>
        <rules>
{% if temporary_management | default(true) %}
          <rule><enabled>1</enabled><statetype>keep</statetype><sequence>1</sequence><action>pass</action>
            <quick>1</quick><interfacenot>0</interfacenot><interface>wan</interface><direction>in</direction>
            <ipprotocol>inet</ipprotocol><protocol>tcp</protocol><source_net>{{ opnsense_management_cidr }}</source_net>
            <source_not>0</source_not><source_port/><destination_net>wanip</destination_net>
            <destination_not>0</destination_not><destination_port>443</destination_port><disablereplyto>0</disablereplyto>
            <log>1</log><allowopts>0</allowopts><nosync>0</nosync><nopfsync>0</nopfsync><tcpflags_any>0</tcpflags_any>
            <description>Allow management HTTPS</description></rule>
          <rule><enabled>1</enabled><statetype>keep</statetype><sequence>2</sequence><action>pass</action>
            <quick>1</quick><interfacenot>0</interfacenot><interface>wan</interface><direction>in</direction>
            <ipprotocol>inet</ipprotocol><protocol>tcp</protocol><source_net>{{ opnsense_management_cidr }}</source_net>
            <source_not>0</source_not><source_port/><destination_net>wanip</destination_net>
            <destination_not>0</destination_not><destination_port>22</destination_port><disablereplyto>0</disablereplyto>
            <log>1</log><allowopts>0</allowopts><nosync>0</nosync><nopfsync>0</nopfsync><tcpflags_any>0</tcpflags_any>
            <description>Allow management SSH</description></rule>
{% endif %}
          <rule><enabled>1</enabled><statetype>keep</statetype><sequence>10</sequence><action>pass</action>
            <quick>1</quick><interfacenot>0</interfacenot><interface>wan</interface><direction>out</direction>
            <ipprotocol>inet46</ipprotocol><protocol>any</protocol><source_net>any</source_net><source_not>0</source_not>
            <source_port/><destination_net>any</destination_net><destination_not>0</destination_not><destination_port/>
            <disablereplyto>1</disablereplyto><log>0</log><allowopts>0</allowopts><nosync>0</nosync>
            <nopfsync>0</nopfsync><tcpflags_any>0</tcpflags_any><description>Allow WAN outbound</description></rule>
          <rule><enabled>1</enabled><statetype>keep</statetype><sequence>20</sequence><action>pass</action>
            <quick>1</quick><interfacenot>0</interfacenot><interface>lan</interface><direction>in</direction>
            <ipprotocol>inet46</ipprotocol><protocol>any</protocol><source_net>{{ opnsense_site_network }}</source_net><source_not>0</source_not>
            <source_port/><destination_net>any</destination_net><destination_not>0</destination_not><destination_port/>
            <disablereplyto>0</disablereplyto><log>0</log><allowopts>0</allowopts><nosync>0</nosync>
            <nopfsync>0</nopfsync><tcpflags_any>0</tcpflags_any><description>Allow LAN traffic</description></rule>
        </rules><snatrules/><npt/><onetoone/>
      </Filter>
    </Firewall>
  </OPNsense>
  <nat>
    <outbound>
      <mode>automatic</mode>
    </outbound>
  </nat>
  <dhcpd/>
  <unbound>
    <enable>1</enable>
    <active_interface>lan</active_interface>
    <outgoing_interface>wan</outgoing_interface>
    <dnssec>1</dnssec>
  </unbound>
  <snmpd>
    <syslocation/>
    <syscontact/>
    <rocommunity>public</rocommunity>
  </snmpd>
  <syslog>
    <reverse/>
  </syslog>
</opnsense>
