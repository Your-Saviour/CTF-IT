# CTF-IT Deployment Environment
# Copy this file to .env and fill in the values below before starting.
# NOTE: The CTF API also requires a root-level .env file — see ../.env.example for
# API-specific variables such as SECRET_KEY and EVENT_QUOTA. AWS values belong
# in this deploy/.env file because Compose interpolates them into the API service.

# ─── Domain ─────────────────────────────────────────────────────────────────

# Base domain for all services.
# Services will be available at:
#   ctf.DOMAIN        — CTF API and dashboard
#   caldera.DOMAIN    — MITRE Caldera C2 server
#   semaphore.DOMAIN  — Ansible Semaphore UI
#   dockhand.DOMAIN   — Container management UI
#   traefik.DOMAIN    — Traefik dashboard
DOMAIN=example.com

# ─── TLS ─────────────────────────────────────────────────────────────────────

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=admin@example.com

# ─── Traefik Dashboard ──────────────────────────────────────────────────────

# Basic auth credentials for the Traefik dashboard.
# Generate with: echo "$(htpasswd -nB admin)" | sed 's/\$/\$\$/g'
# IMPORTANT: All $ signs must be doubled ($$) for docker-compose escaping.
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$REPLACE_ME

# ─── Caldera ────────────────────────────────────────────────────────────────

# Caldera source commit and local image tag. The default source commit is the
# immutable commit behind the official Apache Caldera 5.3.0 release.
# CALDERA_REF=b24f6e7a99cab19cbf417009bda9b9c6c81abc31
# CALDERA_IMAGE_TAG=5.3.0

# ─── Semaphore ──────────────────────────────────────────────────────────────

# Admin account created on first startup
SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_PASSWORD=replace_me
SEMAPHORE_ADMIN_NAME=Admin
SEMAPHORE_ADMIN_EMAIL=admin@example.com

# Encryption key for Semaphore secrets storage
# Generate: openssl rand -base64 32
SEMAPHORE_ACCESS_KEY_ENCRYPTION=replace_me

# ─── Semaphore Database ─────────────────────────────────────────────────────

# PostgreSQL database used by the CTF API. Keep this URL-safe; quickstart uses hex.
CTF_POSTGRES_PASSWORD=replace_me

# PostgreSQL credentials for Semaphore
# Generate password: openssl rand -base64 32
SEMAPHORE_POSTGRES_PASSWORD=replace_me

# ─── VM Provisioning ────────────────────────────────────────────────────────

# External address Caldera agents on target VMs use to beacon back.
# Set to the server's public IP or domain (not the Docker-internal name).
# Port 8888 is published directly (not reverse-proxied) in docker-compose.
# Example: http://198.51.100.1:8888
CALDERA_AGENT_URL=http://YOUR_SERVER_IP:8888

# AWS is the only active provisioning provider. Production should obtain
# credentials from the IAM role attached to the host/workload; do not put AWS
# access keys in either .env file. Attach aws/iam-policy.json to that role.
AWS_DEFAULT_REGION=ap-southeast-2
AWS_ENVIRONMENT=production
AWS_STANDARD_VPC_ID=vpc-replace-me
AWS_STANDARD_SUBNET_ID=subnet-replace-me
AWS_STANDARD_SECURITY_GROUP_IDS=sg-replace-me
AWS_UBUNTU_AMIS={"ap-southeast-2":"ami-replace-me"}
AWS_FREEBSD_AMIS={"ap-southeast-2":"ami-replace-me"}
AWS_AVAILABILITY_ZONES={"ap-southeast-2":"ap-southeast-2a"}
AWS_INSTANCE_TYPES=t3.small,t3.medium,t3.large
AWS_KEY_PAIR_NAME=ctf-it
