# Required — used for session signing and deterministic flag generation (HMAC)
SECRET_KEY=change-me-to-a-random-string

# Required for the first registration on a fresh database. The first user must
# enter this token to become the initial administrator.
ADMIN_BOOTSTRAP_TOKEN=change-me-to-a-second-random-string

# Independent key for credentials encrypted in the application database.
DATA_ENCRYPTION_KEY=change-me-to-a-third-random-string

# Local-development database URL. The production Compose stack supplies its
# own PostgreSQL URL and does not use this value.
DATABASE_URL=sqlite:///ctf.db

# Learner workspace release gate. Leave false until `alembic upgrade head`,
# event readiness, and team/verifier credential provisioning all pass.
LEARNER_TRAINING_ENABLED=false
VERIFICATION_INTERVAL_SECONDS=300
VERIFICATION_VM_CONCURRENCY=5
VERIFICATION_TIMEOUT_SECONDS=10

# Default module selection quota — used when creating the initial event on first
# startup. After that, quotas are managed per-event via the admin panel.
# Optional "categories" and "tags" keys add filters — counts are inclusive of
# modules already picked by type/difficulty (no double-selecting).
# Example with all options:
#   {"vulnerability":{"easy":1,"medium":1,"hard":0},"hardening":{"easy":1,"medium":1,"hard":0},"application_external":{"easy":1},"categories":{"authentication":2},"tags":{"privilege-escalation":1}}
EVENT_QUOTA={"vulnerability":{"easy":1,"medium":1,"hard":0},"hardening":{"easy":1,"medium":1,"hard":0},"application_external":{"easy":1,"medium":0,"hard":0}}

# Port the API is exposed on (default 8080)
# API_PORT=8080

# ── Vultr VM Provisioning ──────────────────────────────────────────────────────
# API key from https://my.vultr.com/settings/#settingsapi
# When set, admins can create and destroy VPS instances directly from CTF-IT.
# VULTR_API_KEY=

# Default Vultr region for new instances. Common codes: ewr (New Jersey),
# lax (Los Angeles), ord (Chicago), ams (Amsterdam), syd (Sydney), mel (Melbourne)
# VULTR_DEFAULT_REGION=ewr

# ── Cloudflare DNS (optional) ──────────────────────────────────────────────────
# When set, each created VM automatically gets a DNS A record: hostname.DOMAIN
# Requires a Cloudflare API token with Zone:DNS:Edit permissions.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_DOMAIN=

# ── AI Red Team Agent ──────────────────────────────────────────────────────────
# OpenAI-compatible API endpoint (e.g., your local LLM server)
# AI_API_BASE=http://localhost:8080/v1

# API key for the AI provider
# AI_API_KEY=

# Model to use (any OpenAI-compatible model ID)
# AI_MODEL=gpt-4o

# Shared API key for CTF API ↔ Agent service communication (generate with: python -c "import secrets; print(secrets.token_hex(16))")
# AGENT_API_KEY=

# API key for agent to call CTF API (required for VM targeting)
# CTF_API_KEY=
# AGENT_API_KEY authenticates API requests forwarded to the AI-agent service.
# CTF_API_KEY authenticates AI-agent callbacks to the CTF API.

# Agent behavior:
# AGENT_MAX_STEPS=100
# AGENT_STEP_TIMEOUT=120
# AGENT_APPROVAL_REQUIRED=true
# AGENT_AUTO_STEP=false
# AGENT_AUTO_STEP_INTERVAL=30

# WebSocket configuration:
# WEBSOCKET_ENABLED=true
# WEBSOCKET_HEARTBEAT_INTERVAL=30

# Error feedback:
# MAX_ERROR_HISTORY=50
# ERROR_DISPLAY_DURATION=300
# AUTO_RETRY_FAILED_OPS=false

# Enable: docker compose --profile ai-agent up -d
EXPO_IT_URL=
EXPO_IT_API_KEY=

# Managed OPNsense image pipeline. OPNsense 26.7 is converted automatically
# from Vultr's FreeBSD 15 x64 image; no ISO hosting or console input is used.
# Required IPv4 CIDR permitted to SSH to the temporary Vultr builder. Prefer
# the control-plane host's public /32; invalid values fail before cloud mutation.
CTF_CONTROL_PLANE_CIDR=
# Snapshot builder baseline and minimum site-firewall plan.
GAMENET_FIREWALL_PLAN=vc2-2c-4gb
