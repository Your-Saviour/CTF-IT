# Required — used for session signing and deterministic flag generation (HMAC)
SECRET_KEY=change-me-to-a-random-string

# Required for the first registration on a fresh database. The first user must
# enter this token to become the initial administrator.
ADMIN_BOOTSTRAP_TOKEN=change-me-to-a-second-random-string

# Independent key for credentials encrypted in the application database.
DATA_ENCRYPTION_KEY=change-me-to-a-third-random-string

# Database URL — defaults to sqlite:///ctf.db, use a postgres URI for production
DATABASE_URL=sqlite:///ctf.db

# Default module selection quota — used when creating the initial event on first
# startup. After that, quotas are managed per-event via the admin panel.
# Optional "categories" and "tags" keys add filters — counts are inclusive of
# modules already picked by type/difficulty (no double-selecting).
# Example with all options:
#   {"vulnerability":{"easy":1,"medium":1,"hard":0},"hardening":{"easy":1,"medium":1,"hard":0},"application_external":{"easy":1},"categories":{"authentication":2},"tags":{"privilege-escalation":1}}
EVENT_QUOTA={"vulnerability":{"easy":1,"medium":1,"hard":0},"hardening":{"easy":1,"medium":1,"hard":0},"application_external":{"easy":1,"medium":0,"hard":0}}

# Port the API is exposed on (default 8080)
# API_PORT=8080

# ── Vultr VM Provisioning ──────────────────────────────────────────────────────
# API key from https://my.vultr.com/settings/#settingsapi
# When set, admins can create and destroy VPS instances directly from CTF-IT.
# VULTR_API_KEY=

# Default Vultr region for new instances. Common codes: ewr (New Jersey),
# lax (Los Angeles), ord (Chicago), ams (Amsterdam), syd (Sydney), mel (Melbourne)
# VULTR_DEFAULT_REGION=ewr

# ── Cloudflare DNS (optional) ──────────────────────────────────────────────────
# When set, each created VM automatically gets a DNS A record: hostname.DOMAIN
# Requires a Cloudflare API token with Zone:DNS:Edit permissions.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_DOMAIN=
